// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "F1 ETL Project",
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    // Mount host docker socket to use docker command from inside container
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    ],
    "containerEnv": {
        "HOST_WORKSPACE": "${localWorkspaceFolder}"
    },
    // Run bash script to install system and python packages
    "postCreateCommand": "bash .devcontainer/post-create.sh '${containerWorkspaceFolder}'",
    // Configure tool-specific properties.
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-azuretools.vscode-docker"
            ]
        }
    }
}